{
  "name": "ts-japi",
  "version": "1.12.7",
  "description": "A highly-modular (typescript-friendly)-framework agnostic library for serializing data to the JSON:API specification",
  "keywords": [
    "json:api",
    "json-api",
    "serializer",
    "normalizer",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mathematic-inc/ts-japi.git"
  },
  "license": "Apache-2.0",
  "author": "Mathematic Inc",
  "main": "lib/index.js",
  "files": [
    "lib"
  ],
  "scripts": {
    "audit": "pnpm audit --audit-level high",
    "benchmark": "tsx ./benchmarks/serializer.benchmark.ts",
    "build": "tsc -b",
    "check": "hk check --all --step oxlint --step oxfmt",
    "clean": "make clean",
    "examples": "tsx ./examples/index.ts",
    "fix": "hk fix --all --step oxlint --step oxfmt",
    "format": "hk fix --all --step oxfmt",
    "hk": "hk check --all --slow",
    "lint": "hk check --all --step oxlint",
    "playground": "tsx ./benchmarks/playground.benchmark.ts",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@types/benchmark": "^2.1.5",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "benchmark": "^2.1.4",
    "lodash": "^4.18.1",
    "oxlint-tsgolint": "^7.0.2006",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
