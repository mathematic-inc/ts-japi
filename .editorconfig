# Generated by ToolConfig from .toolconfig.pkl. Edit that file instead.
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 100

[*.{rs,py,pyi}]
indent_size = 4

[*.go]
indent_style = tab

[{Makefile,*.mk}]
indent_style = tab

[*.{md,markdown}]
max_line_length = 80
